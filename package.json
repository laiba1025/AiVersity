{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx server/index.ts",
    "dev:server:3001": "tsx server/dev3001.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test:azure:storage": "tsx server/test-azure-setup.ts",
    "test:sql": "tsx server/test-sql-setup.ts",
    "db:apply": "tsx server/sql/apply-schema.ts",
    "ingest:corpus": "tsx server/ingest/ingest-blob-to-sql.ts",
    "db:setup-app-user": "tsx server/sql/setup-app-user.ts",
    "upload:local-docs": "tsx server/ingest/upload-local-pdfs.ts",
    "test": "node scripts/run-tests-clean.mjs",
    "test:unit": "node --test --test-reporter tap server/tests/recommendation-engine.unit.test.ts | node scripts/run-tests-plain.mjs",
    "test:integration": "node --test --test-reporter tap server/tests/documents.routes.int.test.ts | node scripts/run-tests-plain.mjs",
    "test:e2e": "node --test --test-reporter tap --import tsx server/tests/e2e-user-journey.test.ts",
    "gen:diagram:test-layers": "mmdc -i docs/images/src/test_layers.mmd -o docs/images/test_layers.png -b transparent",
    "gen:diagram:rag-seq": "mmdc -i docs/images/src/rag_sequence.mmd -o docs/images/rag_sequence.png -b transparent",
    "gen:diagram:e2e-flow": "mmdc -i docs/images/src/e2e_flow.mmd -o docs/images/e2e_flow.png -b transparent",
    "gen:diagram:classes": "mmdc -i docs/images/src/aiversity_classes.mmd -o docs/images/aiversity_classes.png -b transparent",
    "gen:diagram:database": "mmdc -i docs/images/src/database_schema.mmd -o docs/images/database_schema.png -b transparent",
    "gen:diagrams": "npm run gen:diagram:test-layers; npm run gen:diagram:rag-seq; npm run gen:diagram:e2e-flow; npm run gen:diagram:classes; npm run gen:diagram:database",
    "gen:coverage-heatmap": "python docs/images/src/coverage_heatmap.py"
  },
  "dependencies": {
    "@azure/ai-text-analytics": "^5.1.0",
    "@azure/identity": "^4.13.0",
    "@azure/identity-vscode": "^1.0.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/openai": "^2.0.0",
    "@azure/storage-blob": "^12.29.1",
    "@hookform/resolvers": "^3.9.1",
    "@jridgewell/trace-mapping": "^0.3.25",
